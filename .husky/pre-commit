#!/usr/bin/env sh

set -eu

UVX_BIN=$(command -v uvx.exe || command -v uvx || true)
PNPM_BIN=$(command -v pnpm.cmd || command -v pnpm || true)

if [ -z "$UVX_BIN" ]; then
    echo "uvx not found on PATH"
    exit 1
fi

if [ -z "$PNPM_BIN" ]; then
    echo "pnpm not found on PATH"
    exit 1
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

PYTHON_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '^(backend|e2e|services)/.*\.py$' || true)
FRONTEND_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '^frontend/.*\.(ts|tsx|js|jsx|json|css|md)$' || true)
FRONTEND_CODE_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '^frontend/.*\.(ts|tsx|js|jsx)$' || true)

if [ -n "$PYTHON_FILES" ]; then
    echo "Formatting Python with Ruff"
    "$UVX_BIN" ruff format $PYTHON_FILES
    "$UVX_BIN" ruff check --fix $PYTHON_FILES
    git add $PYTHON_FILES
fi

if [ -n "$FRONTEND_FILES" ]; then
    echo "Formatting frontend files with Prettier"
    "$PNPM_BIN" --dir frontend exec prettier --write $FRONTEND_FILES
    git add $FRONTEND_FILES
fi

if [ -n "$FRONTEND_CODE_FILES" ]; then
    echo "Linting frontend code with ESLint"
    "$PNPM_BIN" --dir frontend exec eslint --fix $FRONTEND_CODE_FILES
    git add $FRONTEND_CODE_FILES
fi