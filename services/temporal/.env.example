# =============================================================================
# Temporal Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and customize for your local environment
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal

# Temporal Server Configuration
# DB type (postgres12, postgres, mysql, cassandra)
DB=postgres12
DB_PORT=5432

# Temporal UI Configuration
TEMPORAL_UI_PORT=8080

# Optional: Custom namespace (default: default)
# TEMPORAL_DEFAULT_NAMESPACE=default

# Optional: Enable Temporal metrics
# TEMPORAL_PROMETHEUS_ENDPOINT=0.0.0.0:9090
