# Optional transcribe-service overrides. Root .env loads first.
# Copy to services/transcribe/.env only when these values must differ locally.

# Choose ONE: whisper (self-hosted), aws, azure.
TRANSCRIPTION_PROVIDER=whisper

# ============== Self-Hosted Whisper (HIPAA Compliant - No BAA Required) ==============
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Required only when TRANSCRIPTION_PROVIDER=aws.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# TEMP_S3_BUCKET=folium-transcribe-temp

# Required only when TRANSCRIPTION_PROVIDER=azure.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

PORT=8001
LOG_LEVEL=info
MAX_AUDIO_SIZE_MB=100
TRANSCRIBE_TIMEOUT_SECONDS=300
