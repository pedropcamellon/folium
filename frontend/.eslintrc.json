{
    "extends": [
        "next/core-web-vitals",
        "next/typescript",
        "prettier"
    ],
    "rules": {
        "indent": "off",
        "@typescript-eslint/indent": "off",
        "@typescript-eslint/no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "react/react-in-jsx-scope": "off"
    }
}