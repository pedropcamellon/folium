# Folium local runtime baseline. Copy this file to .env before running Compose.
# A service may provide its own untracked .env to override only differing values.

APP_NAME=Folium
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host-run defaults. Compose overrides these with Docker DNS names where needed.
BACKEND_API_URL=http://localhost:8000
TRANSCRIPTION_SERVICE_URL=http://localhost:8001
SUMMARIZATION_SERVICE_URL=http://localhost:8002
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
VOICE_NOTE_TASK_QUEUE=voice-notes-queue

# Replace placeholders in an untracked root or service-local .env.
DATABASE_URL=postgresql+asyncpg://southdrift:change-me@southdrift-postgres:5432/southdrift_db
JWT_SECRET=replace-with-a-local-secret
STORAGE_PROVIDER=minio
STORAGE_BUCKET=southdrift-dev
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace-with-a-local-access-key
STORAGE_SECRET_KEY=replace-with-a-local-secret-key

# Provider credentials are intentionally unset.
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_OPENAI_KEY=
# AZURE_SPEECH_KEY=
