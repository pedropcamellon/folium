# Folium local secrets and optional overrides.
# Compose owns non-sensitive local defaults. Copy to .env and set real values.

# Application and database secrets
DATABASE_URL=postgresql+asyncpg://folium:replace-with-a-local-password@folium-postgres:5432/folium_db
JWT_SECRET=replace-with-a-local-secret
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
TEMPORAL_POSTGRES_PASSWORD=replace-with-a-local-temporal-postgres-password

# Storage and object-store secrets
STORAGE_ACCESS_KEY=replace-with-a-local-access-key
STORAGE_SECRET_KEY=replace-with-a-local-secret-key
MINIO_ROOT_USER=replace-with-a-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password

# Optional provider credentials; set only when the provider is enabled.
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_OPENAI_KEY=
# AZURE_SPEECH_KEY=
